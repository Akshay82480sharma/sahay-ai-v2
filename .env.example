# ============================================================
# Sahay AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# ============================================================

# ---------- Backend ----------
DATABASE_URL=sqlite:///./sahay.db
LLM_PROVIDER=mock
GEMINI_API_KEY=your_key_here
CORS_ORIGINS=["http://localhost:5173"]

# Alert thresholds (seconds)
ALERT_CRITICAL_UNASSIGNED_SECONDS=120
ALERT_NOT_EN_ROUTE_SECONDS=180
ALERT_NO_UPDATE_SECONDS=300

# Simulator
SIMULATOR_ENABLED=false
ADMIN_TOKEN=your_admin_token_here

# Twilio (optional — leave blank to use mock SMS log)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live

# Alert SMS Configuration
ALERT_SMS_TO=
NOTIFY_KINDS=
NOTIFY_MAX_PER_HOUR=
NOTIFY_ENABLED=

TWILIO_WEBHOOK_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=
NOTIFY_INBOUND_MAX_PER_MIN=
